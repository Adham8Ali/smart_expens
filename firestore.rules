rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Categories ──────────────────────────────────────────────────────────
    // Top-level collection, readable by any authenticated user.
    // Writes are blocked from the client — managed via Firebase Console only.
    match /categories/{categoryId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Users ───────────────────────────────────────────────────────────────
    // Each user can only read/write their own profile document.
    match /users/{uid} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
      // ── User's Custom Categories ──────────────────────────────────────
      match /categories/{categoryId} {
        allow read, write, delete: if request.auth != null
                                    && request.auth.uid == uid;
      }
      // ── Expenses sub-collection ──────────────────────────────────────────
      // Path: users/{uid}/expenses/{expenseId}
      match /expenses/{expenseId} {

        // READ & DELETE: only the owner of the document (path-based access)
        allow read, delete: if request.auth != null
                            && request.auth.uid == uid;

        // CREATE: validate required fields, correct types, and ownership.
        allow create: if request.auth != null
                      && request.auth.uid == uid
                      && request.resource.data.keys().hasAll([
                           'id', 'uid', 'amount', 'categoryId',
                           'date', 'createdAt'
                         ])
                      && request.resource.data.uid == uid
                      && request.resource.data.id is string
                      && request.resource.data.amount is number
                      && request.resource.data.amount > 0
                      && request.resource.data.categoryId is string
                      && request.resource.data.categoryId.size() > 0
                      && request.resource.data.date is timestamp
                      && request.resource.data.createdAt is timestamp;

        // UPDATE: caller must own the EXISTING document and cannot change uid.
        allow update: if request.auth != null
                      && resource.data.uid == uid
                      && request.resource.data.uid == resource.data.uid;
      }

      // ── Reports ───────────────────────────────────────────────────────────
      match /reports/{reportId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }

      // ── AI Reports ────────────────────────────────────────────────────────
      match /ai_reports/{reportId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }
    }

  }
}
